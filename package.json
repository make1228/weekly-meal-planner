{
  "name": "weekly-table",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev-proxy.mjs",
    "build:public": "node scripts/build-public.mjs",
    "test:public": "firebase emulators:exec --config firebase.public.json --project demo-weekly-meal-public --only auth,firestore \"node scripts/run-public-tests.mjs\"",
    "test:accounts": "node --test tests/public/*.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@google-cloud/functions-framework": "5.0.5",
    "esbuild": "0.28.2",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "firebase-tools": "15.36.0"
  }
}
