rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public account paths. The callable backend is the only writer.
    function accountUser(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com'];
    }
    function activeAccount(uid) {
      return get(/databases/$(database)/documents/mealPlannerUsers/$(uid)).data.status == 'active';
    }
    match /mealPlannerUsers/{uid} {
      allow get: if accountUser(uid) && resource.data.status == 'active';
      allow list, write: if false;
      match /data/current {
        allow get: if accountUser(uid) && activeAccount(uid);
        allow list, write: if false;
      }
    }
    match /mealPlannerLegacyData/{sourceId} {
      allow get: if request.auth != null && accountUser(request.auth.uid)
        && activeAccount(request.auth.uid)
        && get(/databases/$(database)/documents/mealPlannerLegacyBindings/$(request.auth.uid)).data.verified == true
        && get(/databases/$(database)/documents/mealPlannerLegacyBindings/$(request.auth.uid)).data.sourceId == sourceId;
      allow list, write: if false;
    }
    // Original source/owner policies are intentionally not exposed here.
    match /{document=**} { allow read, write: if false; }
  }
}
